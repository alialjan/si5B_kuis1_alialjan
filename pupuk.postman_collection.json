          "name": "Semua Pupuk",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "// Test script request GET: GET Semua Pupuk\r\npm.test(\"Status code adalah 200\", function () {\r\n    pm.response.to.have.status(200);\r\n});\r\npm.test(\"Respons berupa array yang tidak kosong\", function () {\r\n    const json = pm.response.json();\r\n    pm.expect(json).to.be.an(\"array\").that.is.not.empty;\r\n});\r\npm.test(\"Setiap item memiliki field id, namaPupuk, jenis, beratKg, harga, dan stok\", function () {\r\n    pm.response.json().forEach(function (item) {\r\n        pm.expect(item).to.have.all.keys(\"id\", \"namaPupuk\", \"jenis\", \"beratKg\", \"harga\", \"stok\");\r\n    });\r\n});"
                ]
              }
            }
          ],
