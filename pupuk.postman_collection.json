          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "// Test script request POST: POST Tambah Pupuk\r\npm.test(\"Status code adalah 201\", function () {\r\n    pm.response.to.have.status(201);\r\n});\r\npm.test(\"Respons sukses dan data sesuai dengan yang dikirim\", function () {\r\n    const json = pm.response.json();\r\n    pm.expect(json.status).to.eql(\"success\");\r\n    pm.expect(json.data.namaPupuk).to.eql(\"Pupuk NPK Booster\");\r\n    pm.expect(json.data.jenis).to.eql(\"anorganik\");\r\n    pm.expect(json.data.id).to.be.a(\"number\");\r\n});\r\nif (pm.response.code === 201) {\r\n    pm.environment.set(\"pupukId\", pm.response.json().data.id);\r\n}"
                ]
              }
            }
